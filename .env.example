# This bot is signal-only — it never places real orders.
# These settings only affect what it recommends and how it sizes the suggestion.

# Portfolio value — used to calculate suggested position size
PORTFOLIO_VALUE_USD=1000

# Signal limits — these are your guardrails
MAX_TRADE_SIZE_USD=100        # No single suggested size exceeds this value
MAX_TRADES_PER_DAY=3          # Bot stops issuing new signals after this many in a calendar day

# Symbols to analyze (comma-separated) and timeframe
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAME=4H
