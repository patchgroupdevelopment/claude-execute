// ════════════════════════════════════════════════════════════════════════════
//  6. ⭐ SEANS MƏNTİQİ — BİRJADAN ASILI OLMAYAN (ƏSAS DÜZƏLİŞ)
// ════════════════════════════════════════════════════════════════════════════
// Köhnə `time(timeframe.period, sess, TZ)` yanaşması simvolun birja seansına
// bağlı idi → BTC/qızıl/CFD-lərdə Asiya heç vaxt işə düşmürdü.
// İndi şamın vaxt damğasından NY saat/dəqiqəsi hesablanır — universal işləyir.

// Qrafik taymfreyminə görə HTF seçimi — "zaman fraktaldır" (D44)
f_autoHtf() =>
    m = timeframe.in_seconds(timeframe.period) / 60
    m <= 1 ? "15" : m <= 3 ? "30" : m <= 5 ? "60" : m <= 15 ? "240" : m <= 60 ? "D" : "W"

htfTf = htfAuto ? f_autoHtf() : htfTfManual

// Presetin effektiv dəyərləri (Balanslı = istifadəçi ayarları olduğu kimi)
isStrict = preset == "Sərt (A+ setup)"
isLoose  = preset == "Sıx (çox siqnal)"
effRR    = isStrict ? math.max(minRR, 2.5)      : isLoose ? math.min(minRR, 1.5)      : minRR
effHtfW  = isStrict ? math.min(htfWin, 8)       : isLoose ? math.max(htfWin, 40)      : htfWin
effSweep = isStrict ? math.max(minSweep, 2)     : isLoose ? 1                         : minSweep
effDisp  = isStrict ? math.max(minDispAtr, 0.6) : isLoose ? math.min(minDispAtr, 0.3) : minDispAtr

nyMin = hour(time, TZ) * 60 + minute(time, TZ)   // 0..1439, NY vaxtı

// "HHMM-HHMM" → [başlanğıc dəq., bitiş dəq.]
f_parse(string s) =>
    p  = str.split(s, "-")
    a  = array.size(p) == 2 ? nz(str.tonumber(array.get(p, 0))) : 0.0
    b  = array.size(p) == 2 ? nz(str.tonumber(array.get(p, 1))) : 0.0
    sm = math.floor(a / 100) * 60 + math.round(a % 100)
    em = math.floor(b / 100) * 60 + math.round(b % 100)
    [sm, em == 0 ? 1440 : em]          // "0000" bitişi = gün sonu (1440)

// Gecə yarısını keçən aralıqlar da düzgün işləyir (məs. 2000-0200)
f_in(string s) =>
    [sm, em] = f_parse(s)
    sm <= em ? (nyMin >= sm and nyMin < em) : (nyMin >= sm or nyMin < em)

// Bakı vaxtı ilə göstərmək üçün (cədvəldə)
f_pad(float v) => (v < 10 ? "0" : "") + str.tostring(math.floor(v), "#")

f_toBaku(string s) =>
    [sm, em] = f_parse(s)
    off = (hour(timenow, TZB) * 60 + minute(timenow, TZB)) - (hour(timenow, TZ) * 60 + minute(timenow, TZ))
    off := off > 720 ? off - 1440 : off < -720 ? off + 1440 : off
    b1 = math.floor(((sm + off) % 1440 + 1440) % 1440)
    b2 = math.floor(((em + off) % 1440 + 1440) % 1440)
    f_pad(b1 / 60) + ":" + f_pad(b1 % 60) + "–" + f_pad(b2 / 60) + ":" + f_pad(b2 % 60)

// ────────────────────────────────────────────────────────────────────────────
//  7. BAZAR TİPİ + TRADE PƏNCƏRƏSİ
// ────────────────────────────────────────────────────────────────────────────
f_autoMkt() =>
    t = str.upper(syminfo.ticker)
    isC = syminfo.type == "crypto" or str.contains(t, "BTC") or str.contains(t, "ETH") or
          str.contains(t, "SOL") or str.contains(t, "XRP")
    isI = str.contains(t, "NAS") or str.contains(t, "NQ")  or str.contains(t, "US100") or
          str.contains(t, "SPX") or str.contains(t, "US500") or str.contains(t, "ES")  or
          str.contains(t, "YM")  or str.contains(t, "US30")  or str.contains(t, "DOW") or
          str.contains(t, "DAX") or str.contains(t, "GER40")
    isG = str.contains(t, "XAU") or str.contains(t, "GOLD") or str.contains(t, "GC") or
          str.contains(t, "XAG") or str.contains(t, "SILVER") or str.contains(t, "OIL") or
          str.contains(t, "WTI") or str.contains(t, "CL")
    isC ? "Kripto (24/7)" : isI ? "İndeks (NAS/SPX/DOW)" : isG ? "Qızıl / Əmtəə" : "Forex"

mkt      = mktMode == "Avtomatik" ? f_autoMkt() : mktMode
isCrypto = mkt == "Kripto (24/7)"
isIndex  = mkt == "İndeks (NAS/SPX/DOW)"
isGold   = mkt == "Qızıl / Əmtəə"

// D17 @00:02:43 — müəllimin ÖZ trade pəncərələri (indikator qutusundan fərqli):
//   İndeks: 08:30–11:00 (08:30 makro data buraxılışı daxil)
//   Forex : 07:00–10:00
//   London: 02:00–05:00 (sweetspot 03:00)
sNyTrade = isIndex ? "0830-1100" : isGold ? "0800-1100" : "0700-1000"

inAsia   = f_in(sAsia)
inLondon = f_in(sLondon)
inNyAm   = f_in(sNyAm)
inLunch  = f_in(sLunch)
inNyPm   = f_in(sNyPm)
inNoTr   = f_in(sNoTr)
inNyTr   = f_in(sNyTrade)

// ⭐ ÖLÇÜLMÜŞ DÜZƏLİŞ (2026-08-24, scripts/test-h1-london-extreme.mjs):
// "London günün ekstremumunu yaradır" iddiası İNDEKSLƏRDƏ TƏKZİB EDİLDİ.
// Günün ekstremumunu tutma faizi (təsadüfi gözlənti 23.4%):
//   ES=F London 6.1% (z=-2.86, sıra 46/48) · NQ=F 12.2% (sıra 41/48)
//   Ən yaxşı pəncərə: ES 08:30-11:30 = 63.3% · NQ 08:00-11:00 = 46.9%
// Yəni müəllimin ARAYIŞ KARTINDAN oxuduğu ICT qaydası (D41 kadrı) forex
// mərkəzlidir; öz təcrübəsindən dediyi "endeksdə 8.5-11 arası" (D17) isə
// ölçmə ilə TƏSDİQLƏNİR. İndekslərdə London defolt olaraq söndürülür.
// Qızılda London neytraldır (24.5% ≈ təsadüfi) — açıq saxlanılır.
useLondon = input.bool(true, "London killzone-da da giriş axtar", group = G_SESS,
     tooltip = "⚠️ ÖLÇÜLMÜŞ: indekslərdə (NQ/ES) London günün ekstremumunu\n" +
               "təsadüfdən AZ tutur (ES 6.1% vs 23.4%, z=-2.86, sıra 46/48).\n" +
               "Ona görə İNDEKSLƏRDƏ defolt söndürülüb.\n" +
               "Qızıl/forexdə açıq qalır — orada neytral və ya faydalı ola bilər.\n" +
               "Bax: knowledge/TRADING-LEARNINGS.md §6")
lonOk = useLondon and not isIndex

// Kripto: birja açılışı yoxdur → killzone məntiqi tətbiq olunmur (D40 @00:28:03)
inTradeWin = isCrypto ? true : ((lonOk and inLondon) or inNyTr or (usePM and inNyPm))
kzName = isCrypto  ? "24/7"   :
         inNyTr    ? "NY"     :
         (lonOk and inLondon) ? "LONDON" :
         inNyPm    ? "NY PM"  :
         inLunch   ? "NAHAR"  :
         inAsia    ? "ASİYA"  :
         inNoTr    ? "CBDR"   : "—"

// ────────────────────────────────────────────────────────────────────────────
//  8. SEANS HIGH/LOW — "toxunulana qədər yaşayır"
// ────────────────────────────────────────────────────────────────────────────
f_sessLvl(bool act) =>
    var float ch = na
    var float cl = na
    var float lh = na
    var float ll = na
    var bool  vh = false
    var bool  vl = false
    st = act and not act[1]
    en = not act and act[1]
    if st
        ch := high
        cl := low
    else if act
        ch := math.max(ch, high)
        cl := math.min(cl, low)
    if en
        lh := ch
        ll := cl
        vh := true
        vl := true
    // ⚠️ KÖK BUQ DÜZƏLİŞİ: sweep yoxlaması səviyyənin ŞAM AÇILANDAKI
    // canlılığını işlətməlidir. Əks halda qiymət səviyyəni deldiyi ANDA
    // səviyyə "ölü" işarələnir və sweep şərti HEÇ VAXT ödənmir —
    // indikator prinsipcə siqnal verə bilmirdi.
    wh = vh
    wl = vl
    if vh and not na(lh) and high > lh
        vh := false
    if vl and not na(ll) and low < ll
        vl := false
    [lh, ll, vh, vl, wh, wl]

[asH, asL, asHv, asLv, asHw, asLw] = f_sessLvl(inAsia)
[loH, loL, loHv, loLv, loHw, loLw] = f_sessLvl(inLondon)
[amH, amL, amHv, amLv, amHw, amLw] = f_sessLvl(inNyAm)
[luH, luL, luHv, luLv, luHw, luLw] = f_sessLvl(inLunch)
[pmH, pmL, pmHv, pmLv, pmHw, pmLw] = f_sessLvl(inNyPm)

// ────────────────────────────────────────────────────────────────────────────
//  9. İSTİNAD SƏVİYYƏLƏRİ (D17 kadrından: TDO · Midnight · D/W/M open)
// ────────────────────────────────────────────────────────────────────────────
f_openAt(int hhmm) =>
    var float v = na
    m = math.floor(hhmm / 100) * 60 + hhmm % 100
    hit = nyMin >= m and nyMin[1] < m and dayofmonth(time, TZ) == dayofmonth(time[1], TZ)
    newDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)
    if hit or (newDay and m == 0)
        v := open
    v

tdo      = f_openAt(tdoHHMM)
midnight = f_openAt(0)
dOpen = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)
wOpen = request.security(syminfo.tickerid, "W", open, lookahead = barmerge.lookahead_on)
mOpen = request.security(syminfo.tickerid, "M", open, lookahead = barmerge.lookahead_on)

// ────────────────────────────────────────────────────────────────────────────
//  10. HTF LİKİDİTE (PDH/PDL/PWH/PWL) — canlılıq izlənir
// ────────────────────────────────────────────────────────────────────────────
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)

f_liveRef(float lv, bool isHigh) =>
    var float p = na
    var bool  v = false
    if not na(lv) and (na(p) or lv != p)
        p := lv
        v := true
    w = v                       // şam açılışındakı vəziyyət — sweep üçün
    if v and not na(p) and (isHigh ? high > p : low < p)
        v := false
    [p, v, w]

[pdhV, pdhL, pdhW] = f_liveRef(pdh, true)
[pdlV, pdlL, pdlW] = f_liveRef(pdl, false)
[pwhV, pwhL, pwhW] = f_liveRef(pwh, true)
[pwlV, pwlL, pwlW] = f_liveRef(pwl, false)

// ────────────────────────────────────────────────────────────────────────────
//  11. GÜNLÜK BIAS (D43 @00:20:07 — mexaniki qayda)
// ────────────────────────────────────────────────────────────────────────────
// Əvvəlki gün bir səviyyəni alıb ONUN O TAYINDA GÖVDƏ ilə bağlanıbsa → davam.
// Yalnız FİTİL atıb geri içəri bağlanıbsa → "saygı duydu" = əks bias.
dC = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
dH2 = request.security(syminfo.tickerid, "D", high[2], lookahead = barmerge.lookahead_on)
dL2 = request.security(syminfo.tickerid, "D", low[2],  lookahead = barmerge.lookahead_on)

tookHi = not na(dH2) and pdh > dH2
tookLo = not na(dL2) and pdl < dL2
clAbove = not na(dH2) and dC > dH2
clBelow = not na(dL2) and dC < dL2

biasBull = (tookHi and clAbove) or (tookLo and not clBelow)
biasBear = (tookLo and clBelow) or (tookHi and not clAbove)
biasTxt  = biasBull and not biasBear ? "BULLISH" : biasBear and not biasBull ? "BEARISH" : "neytral"
biasCol  = biasBull and not biasBear ? C_UP : biasBear and not biasBull ? C_DN : C_NEU

// ────────────────────────────────────────────────────────────────────────────
//  12. STRUKTUR + FVG
// ────────────────────────────────────────────────────────────────────────────
atr = ta.atr(14)
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)

var float swH = na
var float swL = na
var float swHBody = na
var float swLBody = na
if not na(ph)
    swH := ph
    swHBody := math.max(open[pivLen], close[pivLen])
if not na(pl)
    swL := pl
    swLBody := math.min(open[pivLen], close[pivLen])

// FVG: 3 şam, ortadakı displacement boşluq buraxır (D19 @00:01:15)
volAvg = ta.sma(volume, 20)
f_volOk(int j) => not useVol or na(volAvg) or volAvg <= 0 or volume[j + 1] >= volAvg * volMult

f_bullFvg(int j) =>
    bot = high[j + 2]
    top = low[j]
    disp = high[j + 1] - low[j + 1]
    ok = top > bot and disp >= atr * effDisp and close[j + 1] > open[j + 1] and f_volOk(j)
    [ok, top, bot]

f_bearFvg(int j) =>
    top = low[j + 2]
    bot = high[j]
    disp = high[j + 1] - low[j + 1]
    ok = top > bot and disp >= atr * effDisp and close[j + 1] < open[j + 1] and f_volOk(j)
    [ok, top, bot]

[curBull, cbT, cbB] = f_bullFvg(0)
[curBear, csT, csB] = f_bearFvg(0)

// ────────────────────────────────────────────────────────────────────────────
//  13. ⭐ HTF FVG = "VACİB SƏVİYYƏ" (D31 A/B təcrübəsi)
// ────────────────────────────────────────────────────────────────────────────
[hH1, hH3, hL1, hL3, hO2, hC2, hT1] = request.security(syminfo.tickerid, htfTf,
     [high[1], high[3], low[1], low[3], open[2], close[2], time[1]],
     lookahead = barmerge.lookahead_off)

var float htfBullT = na
var float htfBullB = na
var float htfBearT = na
var float htfBearB = na
var int   htfLastT = na

if hT1 != htfLastT
    htfLastT := hT1
    if hL1 > hH3 and hC2 > hO2
        htfBullT := hL1
        htfBullB := hH3
    if hH1 < hL3 and hC2 < hO2
        htfBearT := hL3
        htfBearB := hH1

// FVG-nin ölümü (D33 @00:03:43): 50% orta nöqtədən o tayda GÖVDƏ bağlanışı.
// Fitil girsə problem yoxdur — ona görə close istifadə olunur.
if not na(htfBullT) and close < (htfBullT + htfBullB) / 2
    htfBullT := na
    htfBullB := na
if not na(htfBearT) and close > (htfBearT + htfBearB) / 2
    htfBearT := na
    htfBearB := na

inHtfBull = not na(htfBullT) and low  <= htfBullT and high >= htfBullB
inHtfBear = not na(htfBearT) and high >= htfBearB and low  <= htfBearT

// Zonaya son toxunuşdan neçə şam keçib — "gəldi, reaksiya aldı" məntiqi
var int lastHtfBullBar = na
var int lastHtfBearBar = na
if inHtfBull
    lastHtfBullBar := bar_index
if inHtfBear
    lastHtfBearBar := bar_index
htfNearBull = inHtfBull or (not na(lastHtfBullBar) and bar_index - lastHtfBullBar <= effHtfW)
htfNearBear = inHtfBear or (not na(lastHtfBearBar) and bar_index - lastHtfBearBar <= effHtfW)

// ────────────────────────────────────────────────────────────────────────────
//  14. SHARP TURN (D26 @00:09:39 / D40 @00:13:44)
// ────────────────────────────────────────────────────────────────────────────
// Likiditeni ALARKƏN bir FVG → alındıqdan sonra ƏKS istiqamətdə ikinci FVG.
var int lastBullBar = na
var int lastBearBar = na
if curBull
    lastBullBar := bar_index
if curBear
    lastBearBar := bar_index
sharpUp = curBull and not na(lastBearBar) and (bar_index - lastBearBar) <= 8
sharpDn = curBear and not na(lastBullBar) and (bar_index - lastBullBar) <= 8

// ────────────────────────────────────────────────────────────────────────────
//  15. LİKİDİTE ALIMI (sweep) + KONFLUENS SAYĞACI
// ────────────────────────────────────────────────────────────────────────────
// D32: fitil səviyyəni dəlir, GÖVDƏ geri içəri bağlanır → likidite alımı.
f_swLo(float L, bool live) => live and not na(L) and low  < L and close > L
f_swHi(float L, bool live) => live and not na(L) and high > L and close < L

// Sweep: səviyyənin ŞAM AÇILANDAKI canlılığı işlədilir (…W/…w) — bax f_sessLvl.
nLo = (f_swLo(pdlV, pdlW) ? 1 : 0) + (f_swLo(pwlV, pwlW) ? 1 : 0) +
      (f_swLo(asL, asLw) ? 1 : 0) + (f_swLo(loL, loLw) ? 1 : 0) +
      (f_swLo(amL, amLw) ? 1 : 0) + (f_swLo(luL, luLw) ? 1 : 0) + (f_swLo(pmL, pmLw) ? 1 : 0)
nHi = (f_swHi(pdhV, pdhW) ? 1 : 0) + (f_swHi(pwhV, pwhW) ? 1 : 0) +
      (f_swHi(asH, asHw) ? 1 : 0) + (f_swHi(loH, loHw) ? 1 : 0) +
      (f_swHi(amH, amHw) ? 1 : 0) + (f_swHi(luH, luHw) ? 1 : 0) + (f_swHi(pmH, pmHw) ? 1 : 0)

swLo = nLo > 0
swHi = nHi > 0

sweptName = f_swLo(pdlV, pdlW) or f_swHi(pdhV, pdhW) ? "PDH/L" :
             f_swLo(pwlV, pwlW) or f_swHi(pwhV, pwhW) ? "PWH/L" :
             f_swLo(asL, asLw)  or f_swHi(asH, asHw)  ? "ASIA"  :
             f_swLo(loL, loLw)  or f_swHi(loH, loHw)  ? "LONDON" :
             f_swLo(pmL, pmLw)  or f_swHi(pmH, pmHw)  ? "NYPM"  :
             f_swLo(luL, luLw)  or f_swHi(luH, luHw)  ? "LUNCH" : "NYAM"

// ────────────────────────────────────────────────────────────────────────────
//  16. PREMIUM / DISCOUNT (D24 @00:04:13)
// ────────────────────────────────────────────────────────────────────────────
rngHi = ta.highest(high, 50)
rngLo = ta.lowest(low, 50)
rngMid = (rngHi + rngLo) / 2
pdPct = rngHi > rngLo ? (close - rngLo) / (rngHi - rngLo) * 100 : 50.0
inPremium = close > rngMid
inDiscount = close < rngMid

// ────────────────────────────────────────────────────────────────────────────
//  17. DOL — ən yaxın toxunulmamış likidite (D27)
// ────────────────────────────────────────────────────────────────────────────
// Yalnız CANLI (toxunulmamış) səviyyələr hədəf ola bilər — D24: artıq
// təmizlənmiş sahəyə doğru hədəf qoyma.
f_pick(float best, float cand, bool live, float from, bool above) =>
    float r = best
    if live and not na(cand)
        ok = above ? cand > from : cand < from
        better = na(best) or (above ? cand < best : cand > best)
        if ok and better
            r := cand
    r

f_nearAbove(float from) =>
    float b = na
    b := f_pick(b, pdhV, pdhL, from, true)
    b := f_pick(b, pwhV, pwhL, from, true)
    b := f_pick(b, asH,  asHv, from, true)
    b := f_pick(b, loH,  loHv, from, true)
    b := f_pick(b, amH,  amHv, from, true)
    b := f_pick(b, luH,  luHv, from, true)
    b := f_pick(b, pmH,  pmHv, from, true)
    b

f_nearBelow(float from) =>
    float b = na
    b := f_pick(b, pdlV, pdlL, from, false)
    b := f_pick(b, pwlV, pwlL, from, false)
    b := f_pick(b, asL,  asLv, from, false)
    b := f_pick(b, loL,  loLv, from, false)
    b := f_pick(b, amL,  amLv, from, false)
    b := f_pick(b, luL,  luLv, from, false)
    b := f_pick(b, pmL,  pmLv, from, false)
    b

// ════════════════════════════════════════════════════════════════════════════
//  18. SETUP AVTOMATI:  sweep → displacement/MSS → FVG girişi
// ════════════════════════════════════════════════════════════════════════════
// ⛔ Sweep TƏK BAŞINA siqnal DEYİL (D43 @00:18:48):
//    "Çoğunuzun en büyük yaptığı yanlış: likidite aldı, IFVG oluştu, ben
//     giriyorum. Bu saçma sapan işler yapmayın."
var int   stage    = 0     // 0 boş · 1 sweep · 2 MSS (giriş gözlənilir)
var int   dir      = 0
var int   stageBar = na
var float swExt    = na
var float fvgT     = na
var float fvgB     = na
var float entryPx  = na
var bool  hadSharp = false
var string sweptNm = ""
var int   sweepCnt = 0

var bool  inTrade = false
var float tEntry = na
var float tSl = na
var float tTp1 = na
var float tTp2 = na
var bool  tTp1Hit = false
var int   tDir = 0
var int   tOpenBar = na
var float tRiskV = na

var int   nSig = 0
var int   nTp1 = 0
var int   nTp2 = 0
var int   nSl  = 0
var int   nBe  = 0
var float netR = 0.0

// Rədd sayğacları — filtrlərin nə qədər sərt olduğunu göstərir
var int   nRejHtf = 0     // sweep oldu, amma HTF vacib səviyyə yox idi
var int   nRejRR  = 0     // setup tamamlandı, amma RR minimumdan az idi
var int   nRejFlt = 0     // FVG dolduruldu, amma seans/bias filtri bloklandı
var int   nTimeX  = 0     // vaxt stopu ilə bağlanan mövqe

// ── Açıq mövqe (SL əvvəl yoxlanır — konservativ) ──
if inTrade
    slHit  = tDir == 1 ? low  <= tSl  : high >= tSl
    tp2Hit = tDir == 1 ? high >= tTp2 : low  <= tTp2
    tp1Hit = tDir == 1 ? high >= tTp1 : low  <= tTp1
    if slHit
        if tTp1Hit
            nBe += 1
        else
            nSl += 1
            netR -= 1.0
        inTrade := false
    else if tp2Hit
        if not tTp1Hit
            nTp1 += 1
            tTp1Hit := true
        nTp2 += 1
        netR += tp2RR
        inTrade := false
    else if tp1Hit and not tTp1Hit
        nTp1 += 1
        tTp1Hit := true
        if beOnTp1
            tSl := tEntry
    // Vaxt stopu — mövqeyi bağlayır və state maşınını azad edir
    if inTrade and maxBarsTr > 0 and not na(tOpenBar) and bar_index - tOpenBar >= maxBarsTr
        rReal = tRiskV > 0 ? (close - tEntry) / tRiskV * tDir : 0.0
        netR += rReal
        nTimeX += 1
        inTrade := false

// ── Mərhələ 1: sweep qeydə alınır (HTF filtri BURADA tətbiq olunur) ──
if not inTrade and stage == 0 and barstate.isconfirmed
    htfOkU = not htfOn or htfNearBull
    htfOkD = not htfOn or htfNearBear
    if (swLo or swHi) and not (htfOkU or htfOkD)
        nRejHtf += 1
    if swLo and htfOkU and nLo >= effSweep
        stage := 1
        dir := 1
        stageBar := bar_index
        swExt := low
        hadSharp := false
        sweptNm := sweptName
        sweepCnt := nLo
    else if swHi and htfOkD and nHi >= effSweep
        stage := 1
        dir := -1
        stageBar := bar_index
        swExt := high
        hadSharp := false
        sweptNm := sweptName
        sweepCnt := nHi

if stage == 1
    if dir == 1
        swExt := math.min(swExt, low)
        if sharpUp
            hadSharp := true
    else
        swExt := math.max(swExt, high)
        if sharpDn
            hadSharp := true

// ── Mərhələ 2: MSS = displacement + GÖVDƏ bağlanışı (D32 @00:05:12) ──
if stage == 1 and barstate.isconfirmed
    if bar_index - stageBar > maxWaitMss
        stage := 0
    else
        mssUp = dir == 1  and not na(swH) and close > swH
        mssDn = dir == -1 and not na(swL) and close < swL
        if mssUp or mssDn
            float ft = na
            float fb = na
            for j = 0 to fvgLookback
                if na(ft)
                    [okU, tU, bU] = f_bullFvg(j)
                    [okD, tD, bD] = f_bearFvg(j)
                    if dir == 1 and okU and bU < close
                        ft := tU
                        fb := bU
                    else if dir == -1 and okD and tD > close
                        ft := tD
                        fb := bD
            if not na(ft)
                fvgT := ft
                fvgB := fb
                entryPx := (ft + fb) / 2      // D40: FVG-nin ORTA nöqtəsi
                stage := 2
                stageBar := bar_index

// ── Mərhələ 3: giriş ──
float sigEntry = na
float sigSl   = na
float sigTp1  = na
float sigTp2  = na
float sigRisk = na
float sigDol  = na
int   sigCnt = na

if stage == 2 and not inTrade and barstate.isconfirmed
    if bar_index - stageBar > maxWaitFill
        stage := 0
    else
        // D43 @00:12:22: "IFVG retrace olmaz" — Sharp Turn/IFVG-də geri
        // çəkilmə gözlənilmir, MSS-dən sonrakı şamda bazar qiymətindən girilir.
        fastEntry = hadSharp and bar_index == stageBar + 1
        filled = fastEntry or (dir == 1 ? low <= entryPx : high >= entryPx)

        kzOk    = not useKz or inTradeWin
        lunchOk = isCrypto or not skipLunch or not inLunch
        noTrOk  = isCrypto or not inNoTr
        biasOk  = not useBias or (dir == 1 ? biasBull : biasBear) or allowRev
        pdOk    = not usePD or (dir == 1 ? inDiscount : inPremium)

        if filled and kzOk and lunchOk and noTrOk and biasOk and pdOk
            ent = fastEntry ? close : entryPx

            // Geniş stop (istifadəçi rejimi)
            float slWide = na
            if slMode == "Swing gövdəsi"
                slWide := dir == 1 ? nz(swLBody, swExt) : nz(swHBody, swExt)
            else if slMode == "FVG şamı (aqressiv)"
                slWide := dir == 1 ? fvgB : fvgT
            else
                slWide := dir == 1 ? swExt - atr * slBufAtr : swExt + atr * slBufAtr
            if dir == 1  and slWide >= ent
                slWide := ent - atr * 0.5
            if dir == -1 and slWide <= ent
                slWide := ent + atr * 0.5

            dolTgt = dir == 1 ? f_nearAbove(ent) : f_nearBelow(ent)
            rWide  = math.abs(ent - slWide)
            rrWide = useDol and not na(dolTgt) and rWide > 0 ? math.abs(dolTgt - ent) / rWide : na

            // D43 @00:13:44 — RR pisdirsə stopu FVG gövdəsinə daralt
            float slTight = dir == 1 ? math.max(fvgB, nz(swLBody, fvgB)) : math.min(fvgT, nz(swHBody, fvgT))
            if dir == 1  and slTight >= ent
                slTight := slWide
            if dir == -1 and slTight <= ent
                slTight := slWide
            useTight = useDol and not na(dolTgt) and (na(rrWide) or rrWide < effRR)

            sl   = useTight ? slTight : slWide
            risk = math.abs(ent - sl)
            rr   = useDol and not na(dolTgt) and risk > 0 ? math.abs(dolTgt - ent) / risk : na
            // Hələ də RR azdırsa → SETUP-I BURAX (D43 mexaniki qaydası).
            // İstisna: o tərəfdə toxunulmamış likidite qalmayıbsa (dolTgt = na),
            // DOL rejimi işləmir → sabit R-multiple hədəfinə geri qayıdılır,
            // əks halda bütün səviyyələr süpürüldükdən sonra indikator susardı.
            rrOk = not useDol or na(dolTgt) or (not na(rr) and rr >= effRR)

            if not rrOk
                nRejRR += 1
            if risk > 0 and rrOk
                nSig += 1
                inTrade := true
                tDir := dir
                tEntry := ent
                tSl := sl
                if useDol and not na(dolTgt)
                    tTp1 := dolTgt
                    tTp2 := dir == 1 ? ent + (dolTgt - ent) * 1.5 : ent - (ent - dolTgt) * 1.5
                else
                    tTp1 := dir == 1 ? ent + risk * tp1RR : ent - risk * tp1RR
                    tTp2 := dir == 1 ? ent + risk * tp2RR : ent - risk * tp2RR
                tTp1Hit := false
                tOpenBar := bar_index
                tRiskV := risk
                sigEntry := ent
                sigSl := sl
                sigTp1 := tTp1
                sigTp2 := tTp2
                sigRisk := risk
                sigDol := dolTgt
                sigCnt := sweepCnt
                stage := 0
        else if filled
            nRejFlt += 1
            stage := 0

hasSig  = not na(sigEntry)
riskUsd = accSize * riskPct / 100

// ════════════════════════════════════════════════════════════════════════════
//  19. ÇƏKİLİŞ — səliqəli, minimal
// ════════════════════════════════════════════════════════════════════════════
// Aktiv killzone üçün çox zəif fon (95% şəffaf) — qrafiki boğmur
kzTint = uiKzTint and not isCrypto and inTradeWin ? color.new(inNyTr ? C_ACC : C_GOLD, 95) : na
bgcolor(kzTint, title = "Killzone")

// ── Səviyyələr: hər dəfə silinib yenidən çəkilir (yalnız son şamda) ──
var array<line>  lvlL = array.new<line>()
var array<label> lvlB = array.new<label>()

f_drawLvl(float p, bool live, string txt, color c) =>
    if uiLevels and not na(p) and (live or not uiOnlyLive)
        cc = live ? c : color.new(c, 70)
        x1 = math.max(bar_index - 30, 0)
        array.push(lvlL, line.new(x1, p, bar_index + 12, p, color = cc,
             style = live ? line.style_dotted : line.style_dashed, width = 1))
        array.push(lvlB, label.new(bar_index + 13, p, txt, style = label.style_none,
             textcolor = cc, size = size.tiny))

if barstate.islast
    while array.size(lvlL) > 0
        line.delete(array.pop(lvlL))
    while array.size(lvlB) > 0
        label.delete(array.pop(lvlB))

    f_drawLvl(pdhV, pdhL, "PDH", C_NEU)
    f_drawLvl(pdlV, pdlL, "PDL", C_NEU)
    f_drawLvl(pwhV, pwhL, "PWH", C_ACC)
    f_drawLvl(pwlV, pwlL, "PWL", C_ACC)
    f_drawLvl(asH, asHv, "AS.H", color.blue)
    f_drawLvl(asL, asLv, "AS.L", color.blue)
    f_drawLvl(loH, loHv, "LO.H", color.red)
    f_drawLvl(loL, loLv, "LO.L", color.red)
    f_drawLvl(amH, amHv, "NYAM.H", C_UP)
    f_drawLvl(amL, amLv, "NYAM.L", C_UP)
    f_drawLvl(pmH, pmHv, "NYPM.H", color.purple)
    f_drawLvl(pmL, pmLv, "NYPM.L", color.purple)
    if uiRefs
        f_drawLvl(tdo,      true, "TDO",  C_NEU)
        f_drawLvl(midnight, true, "MN",   C_NEU)
        f_drawLvl(dOpen,    true, "D.O",  C_NEU)
        f_drawLvl(wOpen,    true, "W.O",  C_NEU)
        f_drawLvl(mOpen,    true, "M.O",  C_NEU)

// ── HTF FVG zonası (vacib səviyyə) ──
var box htfBox = na
if barstate.islast
    if not na(htfBox)
        box.delete(htfBox)
        htfBox := na
    if uiHtf
        if not na(htfBullT)
            htfBox := box.new(math.max(bar_index - 60, 0), htfBullT, bar_index + 12, htfBullB,
                 border_color = color.new(C_UP, 55), bgcolor = color.new(C_UP, 92),
                 text = "HTF FVG", text_color = color.new(C_UP, 35), text_size = size.tiny,
                 text_halign = text.align_left, text_valign = text.align_top)
        else if not na(htfBearT)
            htfBox := box.new(math.max(bar_index - 60, 0), htfBearT, bar_index + 12, htfBearB,
                 border_color = color.new(C_DN, 55), bgcolor = color.new(C_DN, 92),
                 text = "HTF FVG", text_color = color.new(C_DN, 35), text_size = size.tiny,
                 text_halign = text.align_left, text_valign = text.align_top)

// ── LTF FVG qutuları (yalnız son bir neçəsi) ──
var array<box> fvgBx = array.new<box>()
if uiFvg and barstate.isconfirmed
    if curBull
        array.push(fvgBx, box.new(bar_index - 2, cbT, bar_index + 4, cbB,
             border_color = color.new(C_UP, 75), bgcolor = color.new(C_UP, 90)))
    if curBear
        array.push(fvgBx, box.new(bar_index - 2, csT, bar_index + 4, csB,
             border_color = color.new(C_DN, 75), bgcolor = color.new(C_DN, 90)))
    while array.size(fvgBx) > uiFvgMax
        box.delete(array.shift(fvgBx))

// ── Sweep / MSS işarələri ──
plotshape(uiMarks and stage == 1 and stage[1] == 0 and dir ==  1, "Sweep ↓", shape.xcross,
     location.belowbar, color.new(C_NEU, 25), size = size.tiny)
plotshape(uiMarks and stage == 1 and stage[1] == 0 and dir == -1, "Sweep ↑", shape.xcross,
     location.abovebar, color.new(C_NEU, 25), size = size.tiny)
plotshape(uiMarks and stage == 2 and stage[1] == 1 and dir ==  1, "MSS ↑", shape.triangleup,
     location.belowbar, color.new(C_ACC, 20), size = size.tiny, text = "mss")
plotshape(uiMarks and stage == 2 and stage[1] == 1 and dir == -1, "MSS ↓", shape.triangledown,
     location.abovebar, color.new(C_ACC, 20), size = size.tiny, text = "mss")

// ── Siqnal: broker üslubunda sifariş xətləri ──
var array<line>  sLn = array.new<line>()
var array<label> sLb = array.new<label>()
if hasSig
    isL = tDir == 1
    xa = bar_index
    xb = bar_index + 26
    array.push(sLn, line.new(xa, sigEntry, xb, sigEntry, color = color.new(C_NEU, 10), width = 1))
    array.push(sLn, line.new(xa, sigSl,    xb, sigSl,    color = C_DN, width = 2))
    array.push(sLn, line.new(xa, sigTp1,   xb, sigTp1,   color = C_UP, width = 1, style = line.style_dashed))
    array.push(sLn, line.new(xa, sigTp2,   xb, sigTp2,   color = color.new(C_UP, 50), style = line.style_dotted))

    rrTxt = sigRisk > 0 ? str.tostring(math.abs(sigTp1 - sigEntry) / sigRisk, "#.##") : "—"
    units = sigRisk > 0 ? riskUsd / sigRisk : na
    head  = (isL ? "▲ AL" : "▼ SAT") + (hadSharp ? " ⚡" : "") + "  " + sweptNm +
             (sigCnt > 1 ? " ×" + str.tostring(sigCnt) : "") + "  ·  RR " + rrTxt
    array.push(sLb, label.new(xb, sigEntry, head, style = label.style_label_left,
         color = color.new(isL ? C_UP : C_DN, 8), textcolor = color.white, size = size.small))
    array.push(sLb, label.new(xb, sigSl, "SL " + str.tostring(sigSl, format.mintick),
         style = label.style_label_left, color = color.new(C_DN, 25), textcolor = color.white, size = size.tiny))
    array.push(sLb, label.new(xb, sigTp1, "TP1 " + str.tostring(sigTp1, format.mintick) +
         (useDol and not na(sigDol) ? "  (DOL)" : ""),
         style = label.style_label_left, color = color.new(C_UP, 25), textcolor = color.white, size = size.tiny))
    array.push(sLb, label.new(xb, sigTp2, "TP2 " + str.tostring(sigTp2, format.mintick),
         style = label.style_label_left, color = color.new(C_UP, 55), textcolor = color.white, size = size.tiny))

    while array.size(sLn) > uiMaxSig * 4
        line.delete(array.shift(sLn))
    while array.size(sLb) > uiMaxSig * 4
        label.delete(array.shift(sLb))

// ════════════════════════════════════════════════════════════════════════════
//  20. İNFO PANELİ — "nə baş verir" bir baxışda
// ════════════════════════════════════════════════════════════════════════════
tblPos = uiTblPos == "Sağ üst" ? position.top_right :
          uiTblPos == "Sağ alt" ? position.bottom_right :
          uiTblPos == "Sol üst" ? position.top_left : position.bottom_left

var table tb = table.new(tblPos, 2, 16, border_width = 1,
      frame_width = 2, frame_color = color.new(C_NEU, 40), bgcolor = #131722)

// Başlıq zolağı — bölmələri ayırır
// Seans işarəsi (qlobal — Pine funksiyaları şərt blokunun içində elan edilə bilməz)
f_mk(bool on) => on ? "⬤ " : "○ "

// Taymfreym xəbərdarlığı: bu model 5m/15m üçündür
tfBadG = not isCrypto and timeframe.in_seconds(timeframe.period) / 60 > 60

f_head(int r, string t) =>
    table.cell(tb, 0, r, t, text_color = color.new(color.white, 15), text_size = size.tiny,
         bgcolor = color.new(C_ACC, 45), text_halign = text.align_left)
    table.cell(tb, 1, r, "", bgcolor = color.new(C_ACC, 45))

// Adi sətir: sol = etiket, sağ = dəyər
f_kv(int r, string k, string v, color vc) =>
    table.cell(tb, 0, r, k, text_color = color.new(color.white, 45), text_size = size.tiny,
         bgcolor = #1a1e29, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = vc, text_size = size.tiny,
         bgcolor = #1a1e29, text_halign = text.align_right)

if uiTable and barstate.islast
    nyNow = f_pad(hour(timenow, TZ))  + ":" + f_pad(minute(timenow, TZ))
    bkNow = f_pad(hour(timenow, TZB)) + ":" + f_pad(minute(timenow, TZB))

    // ══ 1. HARADAYIQ ══
    f_head(0, "🕐  HARADAYIQ")
    f_kv(1, "Saat", "NY " + nyNow + "   ·   Bakı " + bkNow, color.new(color.white, 10))

    // Cari seans — hansının içindəyiksə O işarələnir
    sesNow = inNyAm  ? "NY AM"   : inNyPm ? "NY PM"  : inLunch ? "NAHAR" :
             inLondon ? "LONDON" : inAsia ? "ASİYA"  : inNoTr  ? "CBDR"  : "keçid"
    sesCol = inNyAm or inLondon ? C_UP : inNyPm ? C_ACC : inAsia ? color.blue :
             inLunch or inNoTr ? C_GOLD : C_NEU
    f_kv(2, "Cari seans", "▶ " + sesNow, sesCol)

    // Bütün seanslar Bakı vaxtı ilə — cari olan ⬤ ilə göstərilir
    f_kv(3, "Asiya  " + f_toBaku(sAsia),   f_mk(inAsia)   + (inAsia   ? "İNDİ" : ""), inAsia   ? color.blue : color.new(color.white, 65))
    f_kv(4, "London " + f_toBaku(sLondon), f_mk(inLondon) + (inLondon ? "İNDİ" : ""), inLondon ? color.red  : color.new(color.white, 65))
    f_kv(5, "NY AM  " + f_toBaku(sNyAm),   f_mk(inNyAm)   + (inNyAm   ? "İNDİ" : ""), inNyAm   ? C_UP       : color.new(color.white, 65))
    f_kv(6, "NY PM  " + f_toBaku(sNyPm),   f_mk(inNyPm)   + (inNyPm   ? "İNDİ" : ""), inNyPm   ? color.purple : color.new(color.white, 65))

    // ══ 2. BAZAR ══
    f_head(7, "📊  BAZAR VƏZİYYƏTİ — " + mkt)
    f_kv(8, "Günlük bias", biasTxt, biasCol)
    pdTxt = (inPremium ? "PREMIUM (satış yarısı)" : "DISCOUNT (alış yarısı)") + "  " + str.tostring(pdPct, "#") + "%"
    f_kv(9, "Range mövqeyi", pdTxt, inPremium ? C_DN : C_UP)
    htfOk2 = htfNearBull or htfNearBear
    htfTxt2 = inHtfBull ? "🟢 bull FVG İÇİNDƏ" : inHtfBear ? "🔴 bear FVG İÇİNDƏ" :
               htfNearBull ? "🟢 bull FVG yaxın" : htfNearBear ? "🔴 bear FVG yaxın" : "yoxdur"
    f_kv(10, "HTF vacib səviyyə (" + htfTf + ")", htfTxt2, htfOk2 ? C_UP : C_NEU)

    // ══ 3. SETUP — addım-addım ══
    f_head(11, "🎯  SETUP GEDİŞATI")
    // Vizual zəncir: hansı addım bitib, hansı gözlənilir
    s1 = stage >= 1 ? "✅" : "⬜"
    s2 = stage >= 2 ? "✅" : stage == 1 ? "⏳" : "⬜"
    s3 = inTrade ? "✅" : stage == 2 ? "⏳" : "⬜"
    f_kv(12, "sweep " + s1 + "  →  MSS " + s2 + "  →  giriş " + s3,
         stage > 0 ? sweptNm + (sweepCnt > 1 ? " ×" + str.tostring(sweepCnt) : "") : "—",
         stage > 0 ? C_GOLD : color.new(color.white, 65))

    stTxt2 = tfBadG ? "⚠️ 5m/15m taymfreymə keç!" :
              inTrade ? "mövqe açıqdır" :
              stage == 0 ? "likidite sweep-i gözlənilir" :
              stage == 1 ? "MSS (gövdə bağlanışı) gözlənilir" :
              "FVG " + str.tostring(entryPx, format.mintick) + "-ə çəkilmə gözlənilir"
    f_kv(13, "İndi nə gözlənilir", stTxt2, tfBadG ? C_DN : stage > 0 ? C_GOLD : color.new(color.white, 40))

    // ══ 4. NƏTİCƏ ══
    f_head(14, "💰  MÖVQE / NƏTİCƏ")
    wr2  = nSig > 0 ? 100.0 * nTp1 / nSig : na
    expR2 = nSig > 0 ? netR / nSig : na
    thin2 = nSig < 30
    resTxt = inTrade ?
         (tDir == 1 ? "🟢 LONG " : "🔴 SHORT ") + str.tostring(tEntry, format.mintick) +
         "  SL " + str.tostring(tSl, format.mintick) + (tTp1Hit ? " (BE)" : "") :
         str.tostring(nSig) + " siqnal · TP1 " + (na(wr2) ? "—" : str.tostring(wr2, "#") + "%") +
         " · " + (netR >= 0 ? "+" : "") + str.tostring(netR, "#.#") + "R"
    f_kv(15, inTrade ? "Açıq mövqe" : "Nəticə (script sayır)", resTxt,
         inTrade ? color.white : netR >= 0 ? C_UP : C_DN)

// ════════════════════════════════════════════════════════════════════════════
//  21. ALERT
// ════════════════════════════════════════════════════════════════════════════
alertcondition(hasSig and tDir ==  1, "ICT AL",  "ICT UM — AL siqnalı")
alertcondition(hasSig and tDir == -1, "ICT SAT", "ICT UM — SAT siqnalı")

if hasSig
    alert(syminfo.ticker + " " + (tDir == 1 ? "AL" : "SAT") +
          " · " + kzName + " · sweep " + sweptNm + (sigCnt > 1 ? " ×" + str.tostring(sigCnt) : "") +
          (hadSharp ? " · ⚡IFVG/Sharp Turn" : "") +
          " · Giriş " + str.tostring(sigEntry, format.mintick) +
          " · SL " + str.tostring(sigSl, format.mintick) +
          " · TP1 " + str.tostring(sigTp1, format.mintick) +
          " · TP2 " + str.tostring(sigTp2, format.mintick),
          alert.freq_once_per_bar_close)
