//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  XAU KILL ZONE SNIPER — DXY Aware (Bakı vaxtı)
//  Qızıl (XAUUSD) üçün seans / kill-zone əsaslı likidite-sweep sistemi.
//
//  FƏLSƏFƏ:
//   • SİQNAL verir, əməliyyat AÇMIR. Son qərar səndədir.
//   • Hər siqnalın SABİT stop-loss-u var. Martingale / "zərərdə ekleme" YOXDUR.
//   • TP1 ən azı 1:1 RR — input minimumu 1.0, aşağı düşə bilmir.
//   • TP1 vurulanda stop girişə çəkilir (breakeven).
//   • Script öz nəticəsini ÖZÜ SAYIR — SL, TP-dən ƏVVƏL yoxlanır (konservativ).
//
//  ⚠️ VALİDASİYA VƏZİYYƏTİ: 72 günlük müstəqil backtest-də (GC=F 15m + DXY)
//  48 əməliyyat, TP1 60%, net +7.9R — AMMA t=0.92, yəni statistik olaraq
//  təsadüfdən fərqlənmir. Real pul qoymazdan əvvəl ən azı 150-200 siqnal
//  toplanmalıdır. Bax: scripts/backtest-xau-killzone.mjs
// ════════════════════════════════════════════════════════════════════════════

indicator("XAU Kill Zone Sniper — DXY Aware (AZ)", "XAU KZ Sniper", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ────────────────────────────────────────────────────────────────────────────
//  1. INPUT
// ────────────────────────────────────────────────────────────────────────────
string G_MODE = "⚙️  Rejim və Risk"
mode     = input.string("Scalp", "Rejim", options = ["Scalp", "Swing"], group = G_MODE)
tp1RR    = input.float(1.0, "TP1 — minimum RR", minval = 1.0, step = 0.1, group = G_MODE,
             tooltip = "1.0-dan aşağı düşmür: hər əməliyyatda ən azı riskə bərabər qazanc.")
tp2RR    = input.float(2.0, "TP2 — RR", minval = 1.0, step = 0.1, group = G_MODE)
atrLen   = input.int(14, "ATR uzunluğu", minval = 5, group = G_MODE)
slBufAtr = input.float(0.25, "SL bufferi (×ATR)", minval = 0.0, step = 0.05, group = G_MODE)
minSlAtr = input.float(0.60, "Minimum SL məsafəsi (×ATR)", minval = 0.1, step = 0.05, group = G_MODE,
             tooltip = "Qızılda spread+sürüşmə 20-40 pips ola bilir. Bundan dar stop qoymuruq.")
beOnTp1  = input.bool(true, "TP1-dən sonra stopu girişə çək (breakeven)", group = G_MODE)

string G_ACC = "💰  Hesab və Lot"
accSize    = input.float(1000, "Hesab ($)", minval = 10, group = G_ACC)
riskPct    = input.float(1.5, "Əməliyyat başına risk (%)", minval = 0.1, maxval = 10, step = 0.1, group = G_ACC,
               tooltip = "Lot RİSKDƏN hesablanır, əksinə YOX.")
contractSz = input.float(100, "1 lot = neçə ons", minval = 1, group = G_ACC)

string G_SESS = "🕐  Seanslar və Kill Zone"
sessStyle = input.string("Yalnız H/L xətti", "Seans göstərişi",
             options = ["Yalnız H/L xətti", "Qutu (kontur)", "Yoxdur"], group = G_SESS,
             tooltip = "Qutular üst-üstə düşür (seanslar həqiqətən örtüşür) — ona görə\ndefault olaraq yalnız likidite xətləri göstərilir.")
showKZ    = input.bool(true, "Kill Zone fonu (çox açıq)", group = G_SESS)
kzFilter  = input.bool(true, "Yalnız Kill Zone-da siqnal ver", group = G_SESS)
// Seanslar NEW YORK vaxtı ilə — yay/qış saatı avtomatik düzəlir.
asiaSess = input.session("1900-0400", "Asiya seansı (NY vaxtı)",    group = G_SESS)
lonSess  = input.session("0300-1130", "London seansı (NY vaxtı)",   group = G_SESS)
nySess   = input.session("0800-1700", "New York seansı (NY vaxtı)", group = G_SESS)
kzAsia   = input.session("2000-0000", "Asiya Kill Zone",  group = G_SESS)
kzLon    = input.session("0200-0500", "London Kill Zone", group = G_SESS)
kzNyAm   = input.session("0830-1100", "NY AM Kill Zone",  group = G_SESS,
             tooltip = "ABŞ makro datası (NFP, CPI) burada çıxır — qızılın ən sərt hərəkəti.")
kzNyPm   = input.session("1330-1600", "NY PM Kill Zone",  group = G_SESS)

string G_BIAS = "📈  Trend / Bias"
htfTf      = input.timeframe("60", "Üst taymfreym (bias)", group = G_BIAS)
htfEmaLen  = input.int(50, "HTF EMA", minval = 10, group = G_BIAS)
emaFastLen = input.int(21, "Sürətli EMA (təsdiq)", minval = 5, group = G_BIAS)

string G_DXY = "💵  DXY — tərs korrelyasiya"
useDxy    = input.bool(true, "DXY filtrini işlət", group = G_DXY)
dxySym    = input.symbol("TVC:DXY", "DXY simvolu", group = G_DXY)
dxyEmaLen = input.int(21, "DXY EMA", minval = 5, group = G_DXY)
corrLen   = input.int(20, "Korrelyasiya pəncərəsi", minval = 5, group = G_DXY)
corrBreak = input.float(-0.20, "Korrelyasiya qopma həddi", minval = -1, maxval = 1, step = 0.05, group = G_DXY)

string G_UI = "🎨  Görünüş"
maxSig    = input.int(3, "Qrafikdə saxlanılan siqnal sayı", minval = 1, maxval = 20, group = G_UI,
             tooltip = "Köhnə siqnalların xətləri silinir — qrafik təmiz qalır.")
lineLen   = input.int(24, "SL/TP xəttinin uzunluğu (şam)", minval = 5, maxval = 100, group = G_UI)
showTable = input.bool(true, "Məlumat cədvəli", group = G_UI)
fullTable = input.bool(false, "Tam cədvəl (bütün seans saatları)", group = G_UI)
tblPos    = input.string("Sağ üst", "Cədvəl mövqeyi", options = ["Sağ üst", "Sağ alt", "Sol üst", "Sol alt"], group = G_UI)

SESS_TZ = "America/New_York"

// ────────────────────────────────────────────────────────────────────────────
//  2. KÖMƏKÇİ FUNKSİYALAR
// ────────────────────────────────────────────────────────────────────────────
f_pad(float v) =>
    (v < 10 ? "0" : "") + str.tostring(v, "0")

f_offsetToBaku() =>
    hSrc  = nz(str.tonumber(str.format_time(timenow, "HH", SESS_TZ)))
    hBaku = nz(str.tonumber(str.format_time(timenow, "HH", "Asia/Baku")))
    d = hBaku - hSrc
    d > 12 ? d - 24 : d < -12 ? d + 24 : d

f_hhmmToBaku(float hhmm, float off) =>
    h = math.floor(hhmm / 100)
    m = hhmm % 100
    nh = (h + off + 24) % 24
    f_pad(nh) + ":" + f_pad(m)

f_sessToBaku(string s, float off) =>
    clean = array.get(str.split(s, ":"), 0)
    parts = str.split(clean, "-")
    string res = "—"
    if array.size(parts) == 2
        a = nz(str.tonumber(array.get(parts, 0)))
        b = nz(str.tonumber(array.get(parts, 1)))
        res := f_hhmmToBaku(a, off) + "–" + f_hhmmToBaku(b, off)
    res

f_inSess(string s) =>
    not na(time(timeframe.period, s, SESS_TZ))

f_track(bool active) =>
    var float hi  = na
    var float lo  = na
    var float pHi = na
    var float pLo = na
    started = active and not active[1]
    ended   = not active and active[1]
    if started
        hi := high
        lo := low
    else if active
        hi := math.max(hi, high)
        lo := math.min(lo, low)
    if ended
        pHi := hi
        pLo := lo
    [hi, lo, pHi, pLo, started, active]

f_sweepUp(float lvl) =>
    not na(lvl) and low < lvl and close > lvl and close > open

f_sweepDn(float lvl) =>
    not na(lvl) and high > lvl and close < lvl and close < open

// ────────────────────────────────────────────────────────────────────────────
//  3. SEANSLAR
// ────────────────────────────────────────────────────────────────────────────
inAsia = f_inSess(asiaSess)
inLon  = f_inSess(lonSess)
inNy   = f_inSess(nySess)

inKzAsia = f_inSess(kzAsia)
inKzLon  = f_inSess(kzLon)
inKzNyAm = f_inSess(kzNyAm)
inKzNyPm = f_inSess(kzNyPm)
inAnyKz  = inKzAsia or inKzLon or inKzNyAm or inKzNyPm

kzName = inKzNyAm ? "NY AM" : inKzLon ? "LONDON" : inKzNyPm ? "NY PM" : inKzAsia ? "ASİYA" : "—"

[asiaHi, asiaLo, asiaPHi, asiaPLo, asiaStart, asiaOn] = f_track(inAsia)
[lonHi,  lonLo,  lonPHi,  lonPLo,  lonStart,  lonOn]  = f_track(inLon)
[nyHi,   nyLo,   nyPHi,   nyPLo,   nyStart,   nyOn]   = f_track(inNy)

pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)

// ────────────────────────────────────────────────────────────────────────────
//  4. TREND / BIAS və DXY
// ────────────────────────────────────────────────────────────────────────────
atr     = ta.atr(atrLen)
emaFast = ta.ema(close, emaFastLen)
htfEma  = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen), lookahead = barmerge.lookahead_off)

bullBias = not na(htfEma) and close > htfEma
bearBias = not na(htfEma) and close < htfEma

[dxyC, dxyE] = request.security(dxySym, timeframe.period, [close, ta.ema(close, dxyEmaLen)],
                 lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

dxyOk   = not na(dxyC) and not na(dxyE)
dxyDown = dxyOk and dxyC < dxyE
dxyUp   = dxyOk and dxyC > dxyE
gdCorr  = dxyOk ? ta.correlation(close, dxyC, corrLen) : na
corrHealthy = not na(gdCorr) and gdCorr <= corrBreak
corrBroken  = not na(gdCorr) and gdCorr > corrBreak

// ────────────────────────────────────────────────────────────────────────────
//  5. LİKİDİTE SWEEP
// ────────────────────────────────────────────────────────────────────────────
swAsiaLo = f_sweepUp(asiaPLo)
swAsiaHi = f_sweepDn(asiaPHi)
swLonLo  = f_sweepUp(lonPLo)
swLonHi  = f_sweepDn(lonPHi)
swNyLo   = f_sweepUp(nyPLo)
swNyHi   = f_sweepDn(nyPHi)
swPdLo   = f_sweepUp(pdLow)
swPdHi   = f_sweepDn(pdHigh)

bullSweep = swAsiaLo or swLonLo or swNyLo or swPdLo
bearSweep = swAsiaHi or swLonHi or swNyHi or swPdHi

sweptName = swAsiaLo or swAsiaHi ? "Asiya" : swLonLo or swLonHi ? "London" : swNyLo or swNyHi ? "NY" : swPdLo or swPdHi ? "PD" : "—"

// ────────────────────────────────────────────────────────────────────────────
//  6. GİRİŞ ŞƏRTLƏRİ
// ────────────────────────────────────────────────────────────────────────────
isScalp = mode == "Scalp"
kzOk    = not kzFilter or inAnyKz
biasL   = isScalp ? (close > emaFast or bullBias) : bullBias
biasS   = isScalp ? (close < emaFast or bearBias) : bearBias
dxyOkL  = not useDxy or not dxyOk or dxyDown
dxyOkS  = not useDxy or not dxyOk or dxyUp

rawLong  = bullSweep and biasL and kzOk and dxyOkL
rawShort = bearSweep and biasS and kzOk and dxyOkS

// ────────────────────────────────────────────────────────────────────────────
//  7. ƏMƏLİYYAT VƏZİYYƏTİ + NƏTİCƏNİN ÖZ-ÖZÜNƏ SAYILMASI
// ────────────────────────────────────────────────────────────────────────────
var int   sigTotal = 0
var int   cntTp1   = 0
var int   cntTp2   = 0
var int   cntSl    = 0
var int   cntBe    = 0
var float netR     = 0.0
var bool  inTrade  = false
var int   tDir     = 0
var float tEntry   = na
var float tSl      = na
var float tTp1     = na
var float tTp2     = na
var bool  tTp1Hit  = false

// SIRA VACİBDİR: əvvəl SL, sonra TP (konservativ — bot.js ilə eyni qayda).
if inTrade
    slHit  = tDir == 1 ? low <= tSl : high >= tSl
    tp1Hit = tDir == 1 ? high >= tTp1 : low <= tTp1
    tp2Hit = tDir == 1 ? high >= tTp2 : low <= tTp2
    if slHit
        if tTp1Hit
            cntBe += 1
        else
            cntSl += 1
            netR  -= 1.0
        inTrade := false
    else if tp2Hit
        if not tTp1Hit
            cntTp1 += 1
            tTp1Hit := true
        cntTp2 += 1
        netR   += tp2RR
        inTrade := false
    else if tp1Hit and not tTp1Hit
        cntTp1 += 1
        tTp1Hit := true
        if beOnTp1
            tSl := tEntry

newLong  = rawLong and not inTrade and barstate.isconfirmed
newShort = rawShort and not inTrade and barstate.isconfirmed

float sigEntry = na
float sigSl    = na
float sigTp1   = na
float sigTp2   = na
float sigRisk  = na

if newLong or newShort
    dir   = newLong ? 1 : -1
    ent   = close
    rawSl = dir == 1 ? math.min(low, low[1]) - atr * slBufAtr : math.max(high, high[1]) + atr * slBufAtr
    minD  = atr * minSlAtr
    sl    = dir == 1 ? math.min(rawSl, ent - minD) : math.max(rawSl, ent + minD)
    risk  = math.abs(ent - sl)
    if risk > 0
        sigTotal += 1
        inTrade := true
        tDir    := dir
        tEntry  := ent
        tSl     := sl
        tTp1    := dir == 1 ? ent + risk * tp1RR : ent - risk * tp1RR
        tTp2    := dir == 1 ? ent + risk * tp2RR : ent - risk * tp2RR
        tTp1Hit := false
        sigEntry := ent
        sigSl    := sl
        sigTp1   := tTp1
        sigTp2   := tTp2
        sigRisk  := risk

hasNewSig = not na(sigEntry)

riskUsd = accSize * riskPct / 100
lotSize = hasNewSig and sigRisk > 0 ? riskUsd / (sigRisk * contractSz) : na

// ────────────────────────────────────────────────────────────────────────────
//  8. QRAFİK — TƏMİZ ORDER-LINE ÜSLUBU
// ────────────────────────────────────────────────────────────────────────────
C_WIN = #26a69a
C_LOS = #ef5350

// Kill zone — çox açıq fon (qarışmasın deyə 95% şəffaf)
bgcolor(showKZ and inAnyKz ? color.new(color.purple, 95) : na, title = "Kill Zone")

// Seans qutuları — YALNIZ kontur, doldurma yoxdur (istənilsə)
useBox = sessStyle == "Qutu (kontur)"
f_box(bool started, bool active, float hi, float lo, color c, string txt) =>
    var box b = na
    if started and useBox
        b := box.new(bar_index, hi, bar_index, lo, border_color = c, border_width = 1,
             bgcolor = color.new(color.white, 100), text = txt,
             text_color = color.new(c, 30), text_size = size.tiny,
             text_halign = text.align_left, text_valign = text.align_top)
    if active and useBox and not na(b)
        box.set_right(b, bar_index + 1)
        box.set_top(b, hi)
        box.set_bottom(b, lo)
    b

bxA = f_box(asiaStart, asiaOn, asiaHi, asiaLo, color.new(color.blue, 55),   "ASİYA")
bxL = f_box(lonStart,  lonOn,  lonHi,  lonLo,  color.new(color.orange, 55), "LONDON")
bxN = f_box(nyStart,   nyOn,   nyHi,   nyLo,   color.new(color.green, 55),  "NY")

// Likidite səviyyələri — nazik nöqtəli xətlər (sweep hədəfləri)
useLvl = sessStyle == "Yalnız H/L xətti" or useBox
f_lvl(float p, color c, string txt) =>
    var line l   = na
    var label lb = na
    if useLvl and not na(p)
        if na(l)
            l  := line.new(bar_index - 1, p, bar_index + 8, p, color = c, style = line.style_dotted)
            lb := label.new(bar_index + 9, p, txt, style = label.style_none, textcolor = c, size = size.tiny)
        else
            line.set_xy1(l, bar_index - 1, p)
            line.set_xy2(l, bar_index + 8, p)
            label.set_xy(lb, bar_index + 9, p)
    l

lvA1 = f_lvl(asiaPHi, color.new(color.blue, 45),   "Asiya H")
lvA2 = f_lvl(asiaPLo, color.new(color.blue, 45),   "Asiya L")
lvL1 = f_lvl(lonPHi,  color.new(color.orange, 45), "London H")
lvL2 = f_lvl(lonPLo,  color.new(color.orange, 45), "London L")
lvP1 = f_lvl(pdHigh,  color.new(color.gray, 40),   "PDH")
lvP2 = f_lvl(pdLow,   color.new(color.gray, 40),   "PDL")

// Giriş oxu
plotshape(hasNewSig and tDir == 1,  "AL",  shape.triangleup,   location.belowbar, C_WIN, size = size.tiny)
plotshape(hasNewSig and tDir == -1, "SAT", shape.triangledown, location.abovebar, C_LOS, size = size.tiny)

// ── SL/TP xətləri: broker order-line üslubu, köhnələri avtomatik silinir ──
var array<line>  sigLn = array.new<line>()
var array<label> sigLb = array.new<label>()

if hasNewSig
    isL = tDir == 1
    x1 = bar_index
    x2 = bar_index + lineLen
    array.push(sigLn, line.new(x1, sigEntry, x2, sigEntry, color = color.new(color.gray, 25), width = 1))
    array.push(sigLn, line.new(x1, sigSl,    x2, sigSl,    color = C_LOS, width = 2))
    array.push(sigLn, line.new(x1, sigTp1,   x2, sigTp1,   color = C_WIN, width = 1, style = line.style_dashed))
    array.push(sigLn, line.new(x1, sigTp2,   x2, sigTp2,   color = color.new(C_WIN, 40), width = 1, style = line.style_dotted))

    warnIcon = corrBroken ? " ⚠️" : ""
    array.push(sigLb, label.new(x2, sigEntry, (isL ? "▲ AL " : "▼ SAT ") + str.tostring(sigEntry, format.mintick) + warnIcon,
         style = label.style_label_left, color = color.new(isL ? C_WIN : C_LOS, 10),
         textcolor = color.white, size = size.tiny))
    array.push(sigLb, label.new(x2, sigSl, "SL " + str.tostring(sigSl, format.mintick),
         style = label.style_label_left, color = color.new(C_LOS, 25), textcolor = color.white, size = size.tiny))
    array.push(sigLb, label.new(x2, sigTp1, "TP1 " + str.tostring(sigTp1, format.mintick),
         style = label.style_label_left, color = color.new(C_WIN, 25), textcolor = color.white, size = size.tiny))
    array.push(sigLb, label.new(x2, sigTp2, "TP2 " + str.tostring(sigTp2, format.mintick),
         style = label.style_label_left, color = color.new(C_WIN, 55), textcolor = color.white, size = size.tiny))

    while array.size(sigLn) > maxSig * 4
        line.delete(array.shift(sigLn))
    while array.size(sigLb) > maxSig * 4
        label.delete(array.shift(sigLb))

// ────────────────────────────────────────────────────────────────────────────
//  9. CƏDVƏL (default: yığcam)
// ────────────────────────────────────────────────────────────────────────────
tblPosition = tblPos == "Sağ üst" ? position.top_right : tblPos == "Sağ alt" ? position.bottom_right : tblPos == "Sol üst" ? position.top_left : position.bottom_left
var table tb = table.new(tblPosition, 3, 13, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60))

f_row(table t, int r, string a, string b, string c, color bg) =>
    table.cell(t, 0, r, a, text_color = color.white, text_size = size.tiny, bgcolor = bg, text_halign = text.align_left)
    table.cell(t, 1, r, b, text_color = color.white, text_size = size.tiny, bgcolor = bg, text_halign = text.align_left)
    table.cell(t, 2, r, c, text_color = color.white, text_size = size.tiny, bgcolor = bg, text_halign = text.align_right)

if showTable and barstate.islast
    table.clear(tb, 0, 0, 2, 12)
    off  = f_offsetToBaku()
    cHdr = color.new(color.blue, 25)
    cSub = color.new(color.gray, 55)
    cRow = color.new(color.gray, 88)
    cOn  = color.new(color.green, 35)

    string actSess = (inAsia ? "Asiya " : "") + (inLon ? "London " : "") + (inNy ? "NY" : "")
    if actSess == ""
        actSess := "— bağlı —"

    f_row(tb, 0, "XAU KZ SNIPER", mode, "Bakı " + str.format_time(timenow, "HH:mm", "Asia/Baku"), cHdr)
    f_row(tb, 1, "Aktiv seans", actSess, inAsia or inLon or inNy ? "AÇIQ" : "—", inAsia or inLon or inNy ? cOn : cRow)
    f_row(tb, 2, "Kill Zone", inAnyKz ? kzName + "  " + (inKzNyAm ? f_sessToBaku(kzNyAm, off) : inKzLon ? f_sessToBaku(kzLon, off) : inKzNyPm ? f_sessToBaku(kzNyPm, off) : f_sessToBaku(kzAsia, off)) : "— yoxdur —", inAnyKz ? "▶" : "", inAnyKz ? cOn : cRow)

    int r = 3
    if fullTable
        f_row(tb, 3, "🌏 Asiya",     f_sessToBaku(asiaSess, off), inAsia ? "▶" : "", cRow)
        f_row(tb, 4, "🇬🇧 London",   f_sessToBaku(lonSess, off),  inLon  ? "▶" : "", cRow)
        f_row(tb, 5, "🇺🇸 New York", f_sessToBaku(nySess, off),   inNy   ? "▶" : "", cRow)
        f_row(tb, 6, "📅 Həftəlik bazar", "B.e " + f_hhmmToBaku(1700, off) + " → Şən " + f_hhmmToBaku(1700, off), "", cRow)
        r := 7

    biasTxt = bullBias ? "🟢 YÜKSƏLİŞ" : bearBias ? "🔴 DÜŞÜŞ" : "⚪ neytral"
    f_row(tb, r, "Bias " + htfTf, biasTxt, "ATR " + str.tostring(atr, "#.#"), cRow)

    dxyTxt  = not dxyOk ? "data yox" : dxyDown ? "🔻 düşür" : "🔺 qalxır"
    corrTxt = na(gdCorr) ? "—" : str.tostring(gdCorr, "#.00") + (corrHealthy ? " ✅" : " ⚠️")
    f_row(tb, r + 1, "DXY", dxyTxt, corrTxt, corrBroken ? color.new(color.orange, 50) : cRow)

    posTxt = inTrade ? (tDir == 1 ? "🟢 LONG " : "🔴 SHORT ") + str.tostring(tEntry, format.mintick) : "— yoxdur —"
    slTxt  = inTrade ? "SL " + str.tostring(tSl, format.mintick) + (tTp1Hit ? " BE" : "") : ""
    f_row(tb, r + 2, "Mövqe", posTxt, slTxt, inTrade ? color.new(color.blue, 65) : cRow)

    wr = sigTotal > 0 ? 100.0 * cntTp1 / sigTotal : na
    f_row(tb, r + 3, "Nəticə (özü sayır)",
          str.tostring(sigTotal) + " siqnal · TP1 " + (na(wr) ? "—" : str.tostring(wr, "#") + "%"),
          (netR >= 0 ? "+" : "") + str.tostring(netR, "#.#") + "R", cSub)
    f_row(tb, r + 4, "TP2 / SL / BE",
          str.tostring(cntTp2) + " / " + str.tostring(cntSl) + " / " + str.tostring(cntBe),
          "risk $" + str.tostring(riskUsd, "#"), cRow)

// ────────────────────────────────────────────────────────────────────────────
//  10. ALERT-lər
// ────────────────────────────────────────────────────────────────────────────
alertcondition(hasNewSig and tDir == 1,  "XAU AL siqnalı",  "XAUUSD AL — kill zone likidite sweep")
alertcondition(hasNewSig and tDir == -1, "XAU SAT siqnalı", "XAUUSD SAT — kill zone likidite sweep")

if hasNewSig
    dirTxt = tDir == 1 ? "AL (LONG)" : "SAT (SHORT)"
    alert("XAUUSD " + dirTxt + " · " + kzName + " · Sweep: " + sweptName +
          " · Giriş " + str.tostring(sigEntry, format.mintick) +
          " · SL "    + str.tostring(sigSl, format.mintick) +
          " · TP1 "   + str.tostring(sigTp1, format.mintick) +
          " · TP2 "   + str.tostring(sigTp2, format.mintick) +
          " · Lot "   + str.tostring(lotSize, "#.##") +
          (corrBroken ? " · ⚠️ DXY korrelyasiyası qopub" : ""),
          alert.freq_once_per_bar_close)
